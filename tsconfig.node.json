{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"declaration": true,
		"outDir": "node_modules/.tmp/tsc-node",
		"types": ["node"]
	},
	"include": ["vite.config.ts"]
}
