			"Bash(git push)",
			"Bash(git reset --hard *)",
			"Bash(git reset --hard)",
			"Bash(git clean *)",
			"Bash(git * --force *)",
			"Bash(git * --force)",
			"Bash(git * -f *)",
			"Bash(git * -f)",
			"Bash(git branch -D *)",
			"Bash(git branch -d *)",
			"Bash(git branch --delete *)",
			"Bash(git stash drop *)",
			"Bash(git stash drop)",
			"Bash(git stash clear *)",
			"Bash(git stash clear)",
			"Bash(git checkout -- *)",
			"Bash(git checkout .)",
			"Bash(git checkout . *)",
			"Edit(./yarn.lock)",
			"Edit(./package-lock.json)",
			"Edit(./build/**)",
			"Edit(./node_modules/**)",
			"Bash(npm install -g *)",
			"Bash(npm i -g *)",
			"Bash(npm install --global *)",
			"Bash(npm link *)",
			"Bash(yarn global *)",
			"Bash(yarn link *)",
			"Bash(setx *)",
			"Bash(reg *)",
			"Bash(rm * ~*)",
			"Bash(rm * /*)",
			"Bash(rm * ..*)",
			"Bash(rm * C:*)",
			"Bash(mv * ~*)",
			"Bash(mv * /*)",
			"Bash(mv * ..*)",
			"Bash(mv * C:*)",
			"Bash(cp * ~*)",
			"Bash(cp * /*)",
			"Bash(cp * ..*)",
			"Bash(cp * C:*)",
			"PowerShell(git push *)",
			"PowerShell(git push)",
			"PowerShell(git reset --hard *)",
			"PowerShell(git reset --hard)",
			"PowerShell(git clean *)",
			"PowerShell(git * --force *)",
			"PowerShell(git * --force)",
			"PowerShell(git * -f *)",
			"PowerShell(git * -f)",
			"PowerShell(git branch -D *)",
			"PowerShell(git branch -d *)",
			"PowerShell(git branch --delete *)",
			"PowerShell(git stash drop *)",
			"PowerShell(git stash drop)",
			"PowerShell(git stash clear *)",
			"PowerShell(git stash clear)",
			"PowerShell(git checkout -- *)",
			"PowerShell(git checkout .)",
			"PowerShell(git checkout . *)",
			"PowerShell(npm install -g *)",
			"PowerShell(npm i -g *)",
			"PowerShell(npm install --global *)",
			"PowerShell(npm link *)",
			"PowerShell(yarn global *)",
			"PowerShell(yarn link *)",
			"PowerShell(setx *)",
			"PowerShell(reg *)",
			"PowerShell(rm * ~*)",
			"PowerShell(rm * /*)",
			"PowerShell(rm * ..*)",
			"PowerShell(rm * C:*)",
			"PowerShell(mv * ~*)",
			"PowerShell(mv * /*)",
			"PowerShell(mv * ..*)",
			"PowerShell(mv * C:*)",
			"PowerShell(cp * ~*)",
			"PowerShell(cp * /*)",
			"PowerShell(cp * ..*)",
			"PowerShell(cp * C:*)",
			"PowerShell(Remove-Item * ~*)",
			"PowerShell(Remove-Item ~*)",
			"PowerShell(Remove-Item * /*)",
			"PowerShell(Remove-Item /*)",
			"PowerShell(Remove-Item * ..*)",
			"PowerShell(Remove-Item ..*)",
			"PowerShell(Remove-Item * C:*)",
			"PowerShell(Remove-Item C:*)",
			"PowerShell(Remove-Item * $env:*)",
			"PowerShell(Remove-Item $env:*)",
			"PowerShell(Move-Item * ~*)",
			"PowerShell(Move-Item ~*)",
			"PowerShell(Move-Item * /*)",
			"PowerShell(Move-Item /*)",
			"PowerShell(Move-Item * ..*)",
			"PowerShell(Move-Item ..*)",
			"PowerShell(Move-Item * C:*)",
			"PowerShell(Move-Item C:*)",
			"PowerShell(Move-Item * $env:*)",
			"PowerShell(Move-Item $env:*)",
			"PowerShell(Copy-Item * ~*)",
			"PowerShell(Copy-Item ~*)",
			"PowerShell(Copy-Item * /*)",
			"PowerShell(Copy-Item /*)",
			"PowerShell(Copy-Item * ..*)",
			"PowerShell(Copy-Item ..*)",
			"PowerShell(Copy-Item * C:*)",
			"PowerShell(Copy-Item C:*)",
			"PowerShell(Copy-Item * $env:*)",
			"PowerShell(Copy-Item $env:*)",
			"PowerShell(Set-ItemProperty *)",
			"PowerShell([Environment]::SetEnvironmentVariable*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.js\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.js\"",
						"timeout": 180
					}
				]
			}
		]
	}
}
