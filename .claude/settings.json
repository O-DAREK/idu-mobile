			"PowerShell(npx tsc *)",
			"PowerShell(npx jest *)",
			"PowerShell(npx react-scripts *)",
			"PowerShell(npx prettier *)",
			"PowerShell(git status *)",
			"PowerShell(git status)",
			"PowerShell(git diff *)",
			"PowerShell(git diff)",
			"PowerShell(git log *)",
			"PowerShell(git log)",
			"PowerShell(git show *)",
